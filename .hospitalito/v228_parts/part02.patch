+/* Formularios clínicos claros conservan contraste propio en todos los temas. */
+body[data-hc-theme] #labModalContent :where(input[type="text"],input[type="number"],textarea),
+body[data-hc-theme] #medPanel :where(.heparinStatusBox,.heparinProtocolFormBox,.insulinStatusBox,.insulinProtocolFormBox),
+body[data-hc-theme] #medPanel :where(.heparinStatusBox,.heparinProtocolFormBox,.insulinStatusBox,.insulinProtocolFormBox) *{
+  color:#111827 !important;
+}
+body.hcUiHighContrast :where(.card,.btn,.tab,.censoItem,input,select,textarea){border-width:2px !important;}
+body.hcUiHighContrast .muted{opacity:1 !important;filter:contrast(1.25);}
+body.hcUiLargeText :where(.btn,.tab,input,select,textarea,label,th,td,.muted,.censoItem){font-size:calc(1em + 1px) !important;}
+body.hcUiHideSyncStatus #backendStatus{display:none !important;}
+
+/* Nuevo panel de Configuración. */
+#hcSettingsModal{
+  position:fixed;inset:0;display:none;z-index:2147483644;
+  background:var(--hc-theme-bg);color:var(--hc-theme-text);
+}
+#hcSettingsModal.show{display:block;}
+.hcSettingsShell{height:100dvh;display:grid;grid-template-columns:var(--hc-settings-sidebar) minmax(0,1fr);background:var(--hc-theme-bg);}
+.hcSettingsSidebar{
+  min-width:0;background:color-mix(in srgb,var(--hc-theme-surface) 94%,#000 6%);
+  border-right:1px solid var(--hc-theme-line);display:flex;flex-direction:column;overflow:hidden;
+}
+.hcSettingsBrand{padding:18px 18px 12px;border-bottom:1px solid var(--hc-theme-line);}
+.hcSettingsBrandTitle{font-size:16px;font-weight:900;letter-spacing:-.01em;}
+.hcSettingsBrandSub{margin-top:4px;font-size:12px;color:var(--hc-theme-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.hcSettingsNav{padding:10px;overflow:auto;display:flex;flex-direction:column;gap:3px;flex:1;}
+.hcSettingsNavGroup{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--hc-theme-muted);padding:12px 10px 5px;font-weight:800;}
+.hcSettingsNavBtn{
+  width:100%;display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;border:0;
+  background:transparent;color:var(--hc-theme-text);text-align:left;cursor:pointer;font-weight:650;font-size:13px;
+}
+.hcSettingsNavBtn:hover{background:color-mix(in srgb,var(--hc-theme-surface-2) 80%,transparent);}
+.hcSettingsNavBtn.active{background:var(--hc-theme-accent-soft);color:var(--hc-theme-text);box-shadow:inset 3px 0 0 var(--hc-theme-accent);}
+.hcSettingsNavIcon{width:20px;text-align:center;opacity:.95;}
+.hcSettingsSidebarFoot{padding:10px;border-top:1px solid var(--hc-theme-line);}
+.hcSettingsStage{min-width:0;display:flex;flex-direction:column;height:100dvh;overflow:hidden;background:var(--hc-theme-bg);}
+.hcSettingsTop{
+  min-height:64px;display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:1px solid var(--hc-theme-line);
+  background:color-mix(in srgb,var(--hc-theme-bg) 88%,var(--hc-theme-surface) 12%);flex:0 0 auto;
+}
+.hcSettingsMenuBtn{display:none;}
+.hcSettingsTopTitle{font-size:18px;font-weight:900;letter-spacing:-.02em;}
+.hcSettingsTopSub{font-size:12px;color:var(--hc-theme-muted);margin-top:2px;}
+.hcSettingsTopSpacer{flex:1;}
+.hcSettingsContent{overflow:auto;padding:24px;min-width:0;-webkit-overflow-scrolling:touch;}
+.hcSettingsPage{max-width:1060px;margin:0 auto;}
+.hcSettingsHero{margin-bottom:18px;}
+.hcSettingsHero h2{margin:0;font-size:22px;letter-spacing:-.025em;}
+.hcSettingsHero p{margin:6px 0 0;color:var(--hc-theme-muted);font-size:13px;line-height:1.45;}
+.hcSettingsGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;}
+.hcSettingsGrid.one{grid-template-columns:1fr;}
+.hcSettingsCard{
+  background:color-mix(in srgb,var(--hc-theme-surface) 92%,transparent);border:1px solid var(--hc-theme-line);
+  border-radius:12px;padding:16px;min-width:0;box-shadow:0 8px 24px rgba(0,0,0,.08);
+}
+.hcSettingsCardTitle{font-weight:850;font-size:14px;margin-bottom:4px;}
+.hcSettingsCardSub{font-size:12px;color:var(--hc-theme-muted);line-height:1.45;margin-bottom:12px;}
+.hcSettingsRow{display:flex;align-items:center;gap:12px;min-width:0;}
+.hcSettingsRow.wrap{flex-wrap:wrap;}
+.hcSettingsAvatar{width:76px;height:76px;border-radius:18px;border:1px solid var(--hc-theme-line);background:var(--hc-theme-surface-2);display:grid;place-items:center;overflow:hidden;flex:0 0 auto;}
+.hcSettingsAvatar img{width:100%;height:100%;object-fit:cover;}
+.hcSettingsMeta{min-width:0;flex:1;}
+.hcSettingsName{font-size:18px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.hcSettingsMuted{color:var(--hc-theme-muted);font-size:12px;}
+.hcSettingsFields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:12px;}
+.hcSettingsField{display:flex;flex-direction:column;gap:5px;min-width:0;}
+.hcSettingsField.full{grid-column:1/-1;}
+.hcSettingsField label{font-size:11px;color:var(--hc-theme-muted);font-weight:700;}
+.hcSettingsField :where(input,select,textarea){
+  width:100%;min-width:0;background:var(--hc-theme-input);color:var(--hc-theme-text);border:1px solid var(--hc-theme-line);
+  border-radius:9px;padding:9px 10px;font-size:13px;
+}
+.hcSettingsField textarea{min-height:90px;}
+.hcSettingsActions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;}
+.hcSettingsBtn{
+  border:1px solid var(--hc-theme-line);background:var(--hc-theme-surface-2);color:var(--hc-theme-text);
+  border-radius:9px;padding:8px 11px;font-weight:800;cursor:pointer;font-size:12px;
+}
+.hcSettingsBtn:hover{filter:brightness(1.08);}
+.hcSettingsBtn.primary{background:var(--hc-theme-accent);border-color:var(--hc-theme-accent);color:#fff;}
+.hcSettingsBtn.danger{background:#8f1d27;border-color:#b52a35;color:#fff;}
+.hcSettingsBtn.ghost{background:transparent;}
+.hcSettingsNotice{margin-top:10px;padding:9px 10px;border-radius:9px;border:1px solid var(--hc-theme-line);background:var(--hc-theme-surface-2);font-size:12px;color:var(--hc-theme-muted);line-height:1.45;}
+.hcSettingsNotice.good{border-color:#2f8f57;color:#b7f0cb;background:rgba(47,143,87,.12);}
+.hcSettingsNotice.warn{border-color:#b7791f;color:#f6d89a;background:rgba(183,121,31,.12);}
+body[data-hc-theme="light"] .hcSettingsNotice.good{color:#155b32;}
+body[data-hc-theme="light"] .hcSettingsNotice.warn{color:#6b4b12;}
+.hcThemeGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;}
+.hcThemeTile{border:1px solid var(--hc-theme-line);border-radius:11px;padding:10px;background:var(--hc-theme-surface);cursor:pointer;text-align:left;color:var(--hc-theme-text);}
+.hcThemeTile.active{outline:2px solid var(--hc-theme-accent);outline-offset:1px;}
+.hcThemePreview{height:58px;border-radius:8px;border:1px solid rgba(127,127,127,.25);overflow:hidden;display:grid;grid-template-columns:28% 72%;margin-bottom:8px;}
+.hcThemePreviewSide{background:var(--p-surface);border-right:1px solid var(--p-line);}
+.hcThemePreviewMain{background:var(--p-bg);padding:7px;}
+.hcThemePreviewBar{height:8px;border-radius:99px;background:var(--p-accent);margin-bottom:6px;width:64%;}
+.hcThemePreviewCard{height:22px;border-radius:5px;background:var(--p-surface);border:1px solid var(--p-line);}
+.hcThemeLabel{font-size:12px;font-weight:850;}
+.hcThemeHint{font-size:10px;color:var(--hc-theme-muted);margin-top:2px;}
+.hcToggleRow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid var(--hc-theme-line);}
+.hcToggleRow:last-child{border-bottom:0;}
